# Ling 公共仓库默认使用官方 Electron 下载地址。
# 中国地区贡献者如需镜像，可在本地环境或自己的 .npmrc 中单独设置：
# electron_mirror=https://npmmirror.com/mirrors/electron/

# pnpm 构建脚本白名单（pnpm 默认禁用所有依赖的 postinstall，以下包必须执行原生编译/二进制下载）
# --- pnpm v11+ 格式 ---
allow-builds.better-sqlite3=true
allow-builds.better-sqlite3-multiple-ciphers=true
allow-builds.electron=true
allow-builds.electron-winstaller=true
allow-builds.esbuild=true
allow-builds.sherpa-onnx-node=true
# --- pnpm v9/v10 旧格式（备用） ---
only-built-dependencies[]=better-sqlite3
only-built-dependencies[]=better-sqlite3-multiple-ciphers
only-built-dependencies[]=electron
only-built-dependencies[]=electron-winstaller
only-built-dependencies[]=esbuild
only-built-dependencies[]=sherpa-onnx-node
