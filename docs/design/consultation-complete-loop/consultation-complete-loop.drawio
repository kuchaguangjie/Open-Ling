        <mxCell id="e7" value="结束咨询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="session" target="ending"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ending" target="ended"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ended" target="closing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="closing" target="menu"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="浏览历史" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="menu" target="history"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="读信" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="menu" target="letterCheck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="返回等待室" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="menu" target="lobbyReturn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="返回收尾" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.1;" edge="1" parent="1" source="history" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2870" y="110" /><mxPoint x="2870" y="165" /></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="letterCheck" target="reader"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="pending / failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="letterCheck" target="letterNotice"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="关闭" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.35;" edge="1" parent="1" source="reader" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3150" y="170" /><mxPoint x="3150" y="120" /><mxPoint x="2860" y="120" /><mxPoint x="2860" y="200" /></Array></mxGeometry></mxCell>
        <mxCell id="e18" value="提示结束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="letterNotice" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3150" y="310" /><mxPoint x="2860" y="310" /><mxPoint x="2860" y="240" /></Array></mxGeometry></mxCell>
        <mxCell id="e19" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="created" target="createFailure"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" value="重试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="createFailure" target="create"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="470" /><mxPoint x="585" y="470" /></Array></mxGeometry></mxCell>
        <mxCell id="e21" value="返回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="createFailure" target="waiting"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="500" /></Array></mxGeometry></mxCell>
        <mxCell id="e22" value="取消" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="opening" target="cancelOpening"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" value="删除成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="cancelOpening" target="waiting"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="470" /><mxPoint x="100" y="470" /></Array></mxGeometry></mxCell>
        <mxCell id="e24" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ended" target="endFailure"><mxGeometry relative="1" as="geometry" /></mxCell>
