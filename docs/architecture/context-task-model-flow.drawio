        <mxCell id="assemble" value="按固定顺序组装本轮上下文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;double=1;fontSize=15;fontStyle=1;" vertex="1" parent="live">
