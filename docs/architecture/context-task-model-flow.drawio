        </mxCell>
        <mxCell id="memo-context" value="4. 冻结的咨询备忘录（可选）&#xa;可修正；不是事实、诊断或固定计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="live">
