        <mxCell id="title" value="Ling 当前上下文管理" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#243447;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="800" height="50" as="geometry"/>
