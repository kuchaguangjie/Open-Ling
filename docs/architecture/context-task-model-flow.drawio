        <mxCell id="freeze" value="创建会谈并冻结两份内容&#xa;① 咨询师系统提示词&#xa;② 最新咨询备忘录（可选）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="live">
          <mxGeometry x="505" y="55" width="250" height="90" as="geometry"/>
