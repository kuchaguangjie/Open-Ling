        <mxCell id="turn" value="用户每次发送消息" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="live">
          <mxGeometry x="805" y="65" width="170" height="70" as="geometry"/>
