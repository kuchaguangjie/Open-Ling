          <mxGeometry x="265" y="50" width="190" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="waiting" value="暂不能新建&#xa;等待、重试复盘&#xa;或继续原会谈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="live">
