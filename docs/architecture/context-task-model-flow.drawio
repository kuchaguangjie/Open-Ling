        <mxCell id="review" value="二、结束会谈后：生成跨会谈唯一接续材料" style="swimlane;startSize=42;horizontal=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf9ff;swimlaneFillColor=#ffffff;strokeColor=#9673a6;fontSize=18;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
