        <mxCell id="live" value="一、实时咨询：每轮模型实际收到的上下文" style="swimlane;startSize=42;horizontal=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbff;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
