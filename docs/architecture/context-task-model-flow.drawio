        <mxCell id="system-context" value="1. 冻结的咨询师系统提示词&#xa;核心 + 共同价值观 + 场景 + 团队&#xa;另加当前实时安全策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="live">
          <mxGeometry x="760" y="200" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="profile-context" value="2. 基础个人资料（可选）&#xa;用户主动填写；不是对用户的定论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="live">
