          <mxGeometry x="1330" y="65" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="continue" value="进入下一轮" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="live">
